---
import ArticlePage from '@/components/docs/ArticlePage.astro';
import { getDocSlug, loadDocs } from '@/lib/docs';

export async function getStaticPaths() {
  const docs = await loadDocs();

  return docs
    .filter((doc) => doc.data.category)
    .map((doc) => ({
      params: {
        parent: doc.data.parent,
        category: doc.data.category,
        slug: getDocSlug(doc),
      },
      props: { id: doc.id },
    }));
}

const { id } = Astro.props;
---

<ArticlePage id={id} />
