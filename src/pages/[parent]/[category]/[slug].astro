---
import ArticlePage from '@/components/docs/ArticlePage.astro';
import { getDocHref, loadDocs } from '@/lib/docs';

export async function getStaticPaths() {
  const docs = await loadDocs();
  const nested = docs.filter((doc) => doc.data.category);
  const taken = new Set(nested.map((doc) => `${doc.data.parent}/${doc.data.category}/${doc.id}`));

  return [
    ...nested.map((doc) => ({
      params: {
        parent: doc.data.parent,
        category: doc.data.category,
        slug: doc.id,
      },
      props: { id: doc.id },
    })),
    ...docs.flatMap((doc) => {
      if (doc.data.category) return [];
      const key = `${doc.data.parent}/oversikt/${doc.id}`;
      if (taken.has(key)) return [];
      return [
        {
          params: { parent: doc.data.parent, category: 'oversikt', slug: doc.id },
          props: { destination: getDocHref(doc) },
        },
      ];
    }),
  ];
}

const { id, destination } = Astro.props;
if (destination) return Astro.redirect(destination);
---

<ArticlePage id={id} />
