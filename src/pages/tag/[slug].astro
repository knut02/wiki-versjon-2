---
import PaginatedArticleList from "@/components/PaginatedArticleList.astro";
import Breadcrumbs from "@/components/layout/Breadcrumbs.astro";
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDocHref, loadDocs } from "@/lib/docs";

export async function getStaticPaths() {
  const docs = await loadDocs();
  const slugs = new Set(docs.flatMap((doc) => doc.entry.data.tags.map((tag) => tag.slug)));
  return [...slugs].map((slug) => ({ params: { slug } }));
}

const docs = await loadDocs();
const slug = Astro.params.slug ?? "";
const name = docs.flatMap((doc) => doc.entry.data.tags).find((tag) => tag.slug === slug)?.name ?? slug;
const articles = docs.filter((doc) => doc.entry.data.tags.some((tag) => tag.slug === slug));
---

<BaseLayout title={name} description={`Tagg · ${name}`}>
  <div class="shell shell-narrow py-12 md:py-16">
    <Breadcrumbs items={[{ label: "Hjem", href: "/" }, { label: name }]} />
    <header class="mt-6 border-b border-line pb-8">
      <p class="eyebrow">Tagg</p>
      <h1 class="mt-3 text-[2.15rem] leading-[1.15] font-bold tracking-[-0.035em] md:text-[2.6rem]">{name}</h1>
      <p class="docs-meta mt-5">
        <span class="docs-meta-item">
          <Icon name="file-text" class="size-[0.9rem]" />
          {`${articles.length} ${articles.length === 1 ? "artikkel" : "artikler"}`}
        </span>
      </p>
    </header>
    <div class="mt-8">
      <PaginatedArticleList
        items={articles.map((doc) => ({
          title: doc.data.title,
          description: doc.data.description,
          href: getDocHref(doc),
        }))}
      />
    </div>
  </div>
</BaseLayout>
