---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDocHref, getTags, loadDocs, tagLetterKey, tagLetterLabel } from "@/lib/docs";

interface ArticleLink {
  title: string;
  href: string;
}

interface TagGroup {
  slug: string;
  name: string;
  articles: ArticleLink[];
}

interface Props {
  label: string;
  tags: TagGroup[];
}

export async function getStaticPaths() {
  const docs = await loadDocs();
  const names = new Map(getTags(docs).map((tag) => [tag.slug, tag.name]));
  const letters = new Map<string, Map<string, TagGroup>>();

  for (const doc of docs) {
    const article = { title: doc.data.title, href: getDocHref(doc) };
    const seen = new Set<string>();
    for (const tag of doc.entry.data.tags) {
      if (seen.has(tag.slug)) continue;
      seen.add(tag.slug);
      const name = names.get(tag.slug) ?? tag.name;
      const key = tagLetterKey(name);
      const group = letters.get(key) ?? new Map();
      const entry = group.get(tag.slug) ?? { slug: tag.slug, name, articles: [] };
      entry.articles.push(article);
      group.set(tag.slug, entry);
      letters.set(key, group);
    }
  }

  return [...letters].map(([slug, tags]) => ({
    params: { slug },
    props: {
      label: tagLetterLabel(slug),
      tags: [...tags.values()].sort((a, b) => a.name.localeCompare(b.name, "nb") || a.slug.localeCompare(b.slug)),
    },
  }));
}

const { label, tags } = Astro.props;
---

<BaseLayout title={label} description={`Tagger på ${label}`}>
  <div class="shell py-12 md:py-16">
    <a href="/tag" class="eyebrow">Alle tags</a>
    <h1 class="mt-3 text-[2.15rem] leading-[1.15] font-bold tracking-[-0.035em] md:text-[2.6rem]">{label}</h1>
    <p class="docs-meta mt-5">
      {tags.length} {tags.length === 1 ? "tagg" : "tagger"}
    </p>
    <ul class="article-tags mt-8">
      {
        tags.map((tag) => (
          <li>
            <a href={`#${tag.slug}`}>{tag.name}</a>
          </li>
        ))
      }
    </ul>
    {
      tags.map((tag) => (
        <section class="mt-12" aria-labelledby={tag.slug}>
          <h2 id={tag.slug} class="text-xl font-semibold tracking-[-0.02em] text-ink">
            {tag.name}
          </h2>
          <p class="docs-meta mt-2">
            {tag.articles.length} {tag.articles.length === 1 ? "artikkel" : "artikler"}
          </p>
          <div class="panel mt-4 overflow-hidden">
            {tag.articles.map((article) => (
              <a href={article.href} class="row-link">
                <span class="min-w-0 flex-1 font-semibold text-ink">{article.title}</span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>
