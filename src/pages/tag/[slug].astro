---
import "@/styles/global.css";
import { siteConfig } from "@/config/site";
import { getDocHref, getTags, loadDocs } from "@/lib/docs";

interface ArticleLink {
  title: string;
  href: string;
}

interface Props {
  name: string;
  articles: ArticleLink[];
}

export async function getStaticPaths() {
  const docs = await loadDocs();
  const groups = new Map<string, Props>(getTags(docs).map((tag) => [tag.slug, { name: tag.name, articles: [] }]));

  for (const doc of docs) {
    const article = { title: doc.data.title, href: getDocHref(doc) };
    const seen = new Set<string>();
    for (const tag of doc.entry.data.tags) {
      if (seen.has(tag.slug)) continue;
      seen.add(tag.slug);
      groups.get(tag.slug)?.articles.push(article);
    }
  }

  return [...groups].map(([slug, props]) => ({ params: { slug }, props }));
}

const { name, articles } = Astro.props;
const pageTitle = `${name} | ${siteConfig.name}`;
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={`Tagg · ${name}`} />
  </head>
  <body>
    <main class="shell shell-narrow py-12 md:py-16">
      <a href="/tag" class="eyebrow">Alle tags</a>
      <h1 class="mt-3 text-[2.15rem] leading-[1.15] font-bold tracking-[-0.035em] md:text-[2.6rem]">{name}</h1>
      <p class="docs-meta mt-5">
        {articles.length} {articles.length === 1 ? "artikkel" : "artikler"}
      </p>
      <div class="panel mt-8 overflow-hidden">
        {
          articles.map((article) => (
            <a href={article.href} class="row-link">
              <span class="min-w-0 flex-1 font-semibold text-ink">{article.title}</span>
            </a>
          ))
        }
      </div>
    </main>
  </body>
</html>
