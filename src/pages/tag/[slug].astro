---
import "@/styles/global.css";
import SearchDialog from "@/components/chrome/SearchDialog.astro";
import SiteHeader from "@/components/chrome/SiteHeader.astro";
import { home } from "@/config/home";
import { siteConfig } from "@/config/site";
import { getDocHref, getSuggestedSearchArticles, getTags, loadDocs } from "@/lib/docs";

interface ArticleLink {
  title: string;
  href: string;
}

interface Props {
  name: string;
  articles: ArticleLink[];
}

export async function getStaticPaths() {
  const docs = await loadDocs();
  const groups = new Map<string, Props>(getTags(docs).map((tag) => [tag.slug, { name: tag.name, articles: [] }]));

  for (const doc of docs) {
    const article = { title: doc.data.title, href: getDocHref(doc) };
    const seen = new Set<string>();
    for (const tag of doc.entry.data.tags) {
      if (seen.has(tag.slug)) continue;
      seen.add(tag.slug);
      groups.get(tag.slug)?.articles.push(article);
    }
  }

  return [...groups].map(([slug, props]) => ({ params: { slug }, props }));
}

const { name, articles } = Astro.props;
const pageTitle = `${name} | ${siteConfig.name}`;
const suggestions = getSuggestedSearchArticles(await loadDocs(), {
  limit: 5,
  categories: home.popular.categories,
});
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={`Tagg · ${name}`} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon-light.svg" id="site-favicon" />
    <script is:inline>
      (() => {
        const storageKey = "compass-theme";
        const root = document.documentElement;
        const systemDark = window.matchMedia("(prefers-color-scheme: dark)");
        let stored = null;

        try {
          stored = localStorage.getItem(storageKey);
        } catch {}

        const apply = (isDark) => {
          root.classList.toggle("dark", isDark);
          const favicon = document.getElementById("site-favicon");
          if (favicon) favicon.setAttribute("href", isDark ? "/favicon-dark.svg" : "/favicon-light.svg");
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.setAttribute("aria-pressed", String(isDark));
          });
        };

        apply(stored ? stored === "dark" : systemDark.matches);

        systemDark.addEventListener("change", (event) => {
          if (!stored) apply(event.matches);
        });

        document.addEventListener("DOMContentLoaded", () => {
          apply(root.classList.contains("dark"));
          document.querySelectorAll("[data-theme-toggle]").forEach((button) => {
            button.addEventListener("click", () => {
              const isDark = !root.classList.contains("dark");
              stored = isDark ? "dark" : "light";
              try {
                localStorage.setItem(storageKey, stored);
              } catch {}
              apply(isDark);
            });
          });
        });
      })();
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a class="skip-link" href="#content">Hopp til innhold</a>
    <SiteHeader />
    <main id="content" class="shell shell-narrow flex-1 py-12 md:py-16">
      <a href="/tag" class="eyebrow">Alle tags</a>
      <h1 class="mt-3 text-[2.15rem] leading-[1.15] font-bold tracking-[-0.035em] md:text-[2.6rem]">{name}</h1>
      <p class="docs-meta mt-5">
        {articles.length} {articles.length === 1 ? "artikkel" : "artikler"}
      </p>
      <div class="panel mt-8 overflow-hidden">
        {
          articles.map((article) => (
            <a href={article.href} class="row-link">
              <span class="min-w-0 flex-1 font-semibold text-ink">{article.title}</span>
            </a>
          ))
        }
      </div>
    </main>
    <SearchDialog suggestions={suggestions} />
  </body>
</html>
