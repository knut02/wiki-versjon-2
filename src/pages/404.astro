---
import Icon from "@/components/ui/Icon.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getParents, loadDocs } from "@/lib/docs";

const parents = getParents(await loadDocs());
---

<BaseLayout title="Fant ikke siden" description="Siden finnes ikke." noindex>
  <section class="hero">
    <div class="shell shell-narrow flex flex-col items-center py-24 text-center md:py-32">
      <p class="hero-pill">
        <span class="hero-pill-dot">
          <Icon name="compass" class="size-3.5" />
        </span>
        Feil 404
      </p>
      <h1 class="hero-title mt-6 text-[2.5rem] leading-[1.1] font-bold tracking-[-0.045em] md:text-6xl">
        Siden finnes ikke
      </h1>
      <p class="mt-5 max-w-lg text-[1.05rem] leading-relaxed text-muted">
        Lenken kan være utdatert, eller adressen kan være skrevet feil. Søk, eller start i en av kategoriene under.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <button type="button" class="button button-primary" data-search-open>
          <Icon name="search" class="size-4" />
          Søk
        </button>
        <a href="/" class="button button-secondary">Til forsiden</a>
      </div>
      <div class="mt-12 flex flex-wrap justify-center gap-2">
        {
          parents.map((parent) => (
            <a href={`/${parent.slug}`} class="popular-chip">
              {parent.name}
              <Icon name="arrow-right" class="size-3.5" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
