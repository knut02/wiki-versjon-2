---
import Icon from '@/components/ui/Icon.astro';
import { ui } from '@/i18n';
import type { SearchSuggestion } from '@/lib/docs';

interface Props {
  suggestions: SearchSuggestion[];
}

const { suggestions } = Astro.props;
---

<dialog class="search-dialog" aria-label={ui.search.label} data-search-dialog>
  <div
    class="search-dialog-panel"
    role="search"
    data-docs-search
    data-search-mode="dialog"
    data-search-empty={ui.search.empty}
    data-search-error={ui.search.error}
    data-search-suggestions={JSON.stringify(suggestions)}
  >
    <div class="search-dialog-field">
      <Icon name="search" class="size-[1.15rem] text-muted" />
      <label for="search-dialog-input" class="sr-only">
        {ui.search.label}
      </label>
      <p id="search-dialog-hint" class="sr-only">
        {ui.search.hint}
      </p>
      <p id="search-dialog-status" class="sr-only" aria-live="polite" data-search-status></p>
      <input
        id="search-dialog-input"
        type="search"
        role="combobox"
        class="search-input h-full text-[0.95rem]"
        placeholder={ui.search.placeholder}
        autocomplete="off"
        spellcheck="false"
        aria-autocomplete="list"
        aria-controls="search-dialog-results"
        aria-describedby="search-dialog-hint search-dialog-status"
        aria-expanded="false"
        aria-haspopup="listbox"
        data-search-input
      />
      <button type="button" class="kbd !h-6 cursor-pointer !px-1.5" aria-label={ui.search.close} data-search-close>
        Esc
      </button>
    </div>
    <div
      id="search-dialog-results"
      class="search-results hidden"
      role="listbox"
      aria-label={ui.search.results}
      aria-hidden="true"
      data-search-results
    ></div>
    <div class="search-dialog-footer hidden sm:flex" aria-hidden="true">
      <span class="inline-flex items-center gap-1.5">
        <kbd class="kbd">↑</kbd>
        <kbd class="kbd">↓</kbd> {ui.search.navigate}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <kbd class="kbd">↵</kbd> {ui.search.open}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <kbd class="kbd">esc</kbd> {ui.search.dismiss}
      </span>
      <span class="ml-auto">{ui.search.poweredBy}</span>
    </div>
  </div>
</dialog>

<script>
  import '../../scripts/docs-search';
</script>
