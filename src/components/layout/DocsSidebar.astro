---
import Icon from '@/components/ui/Icon.astro';
import type { DocsParent, SidebarGroup } from '@/lib/docs';

interface Props {
  parent: DocsParent;
  groups: SidebarGroup[];
  currentHref: string;
}

const { parent, groups, currentHref } = Astro.props;
---

<nav class="docs-rail pr-2" aria-label={`Underkategorier i ${parent.name}`}>
  <a
    href={`/${parent.slug}`}
    class="eyebrow mb-5 block hover:text-ink"
    aria-current={currentHref === `/${parent.slug}` ? 'page' : undefined}
  >
    {parent.name}
  </a>
  {groups.map((group) => (
    <div class="docs-sidebar-group">
      <a
        href={group.href}
        class="docs-sidebar-heading"
        aria-current={currentHref === group.href || currentHref.startsWith(`${group.href}/`) ? 'page' : undefined}
      >
        <span class="icon-tile size-7 !rounded-lg">
          <Icon name={group.icon} class="size-[0.9rem]" />
        </span>
        {group.name}
      </a>
    </div>
  ))}
</nav>
